<?xml version="1.0" encoding="UTF-8"?>
<quiqqer>
    <settings>

        <config>
            <section name="general">
                <conf name="active">
                    <type><![CDATA[boolean]]></type>
                    <defaultvalue>1</defaultvalue>
                </conf>
                <conf name="access_lifetime">
                    <type><![CDATA[int]]></type>
                    <defaultvalue>3600</defaultvalue>
                </conf>
                <conf name="refresh_token_lifetime">
                    <type><![CDATA[int]]></type>
                    <defaultvalue>1209600</defaultvalue>
                </conf>
                <conf name="refresh_token_rotation_grace_period">
                    <type><![CDATA[int]]></type>
                    <defaultvalue>120</defaultvalue>
                </conf>
                <conf name="protected_scopes">
                    <type><![CDATA[string]]></type>
                </conf>
                <conf name="dynamic_client_registration">
                    <type><![CDATA[boolean]]></type>
                    <defaultvalue>1</defaultvalue>
                </conf>
            </section>
        </config>

        <window name="quiqqer-oauth-server">
            <title>OAuth</title>
            <params>
                <icon>fa fa-key</icon>
            </params>

            <categories>
                <category name="cron_settings">
                    <text>OAuth</text>
                    <icon>fa fa-key</icon>

                    <settings title="settings" name="settings">
                        <title>
                            <locale group="quiqqer/oauth-server" var="settings.title"/>
                        </title>

                        <input conf="general.active" type="checkbox">
                            <text>
                                <locale group="quiqqer/oauth-server" var="settings.active.text"/>
                            </text>
                            <description>
                                <locale group="quiqqer/oauth-server" var="settings.active.description"/>
                            </description>
                        </input>

                        <input conf="general.access_lifetime" type="number" min="1">
                            <text>
                                <locale group="quiqqer/oauth-server" var="settings.access_lifetime.text"/>
                            </text>
                            <description>
                                <locale group="quiqqer/oauth-server" var="settings.access_lifetime.description"/>
                            </description>
                        </input>

                        <input conf="general.refresh_token_lifetime" type="number" min="1">
                            <text>
                                <locale group="quiqqer/oauth-server" var="settings.refresh_token_lifetime.text"/>
                            </text>
                            <description>
                                <locale group="quiqqer/oauth-server" var="settings.refresh_token_lifetime.description"/>
                            </description>
                        </input>

                        <input conf="general.refresh_token_rotation_grace_period" type="number" min="0">
                            <text>
                                <locale group="quiqqer/oauth-server" var="settings.refresh_token_rotation_grace_period.text"/>
                            </text>
                            <description>
                                <locale group="quiqqer/oauth-server" var="settings.refresh_token_rotation_grace_period.description"/>
                            </description>
                        </input>

                        <input conf="general.protected_scopes" type="string" data-qui="package/quiqqer/oauth-server/bin/backend/controls/settings/ProtectedScopes">
                            <text>
                                <locale group="quiqqer/oauth-server" var="settings.protected_scopes.text"/>
                            </text>
                            <description>
                                <locale group="quiqqer/oauth-server" var="settings.protected_scopes.description"/>
                            </description>
                        </input>

                        <input conf="general.dynamic_client_registration" type="checkbox">
                            <text>
                                <locale group="quiqqer/oauth-server" var="settings.dynamic_client_registration.text"/>
                            </text>
                            <description>
                                <locale group="quiqqer/oauth-server" var="settings.dynamic_client_registration.description"/>
                            </description>
                        </input>
                    </settings>

                </category>
            </categories>
        </window>

    </settings>
</quiqqer>
